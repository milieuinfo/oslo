mobiliteit:ContactinfoPubliek a owl:Class;
    rdfs:label "ContactinfoPubliek"@nl;
    rdfs:comment "Contactgegevens die al dan niet publiek zijn."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf schema:ContactPoint.
mobiliteit:DraagconstructieRetroreflecterendeVerkeersborden a owl:Class;
    rdfs:label "Draagconstructie retroreflecterende verkeersborden"@nl;
    vann:usageNote "Deze draagconstructie verschilt van de draagconstructies voor inwendig verlichte en dynamische verkeersborden."@nl;
    rdfs:comment "Constructie die geschikt is om retroreflecterende verkeersborden aan op te hangen."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:DraagconstructieVerkeersborden.
mobiliteit:Synergieaanvraag a owl:Class;
    rdfs:label "Synergy application"@en, "Synergieaanvraag"@nl;
    rdfs:comment "Verzoek tot samenwerking in een synergie."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:Samenwerkingsaanvraag.
mobiliteit:Verkeersbordcategorie a owl:Class;
    rdfs:label "Verkeersbordcategorie"@nl;
    rdfs:comment "Categorie van een verkeersbord."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf skos:Concept.
mobiliteit:Verkeersmaatregel a owl:Class;
    rdfs:label "Traffic Measure"@en, "Verkeersmaatregel"@nl;
    rdfs:comment "Maatregel waarvan de aard, omvang en plaatsing zijn omschreven in de wegcode en uitvoeringsbesluiten."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:Mobiliteitsmaatregel.
mobiliteit:Innameverbod a owl:Class;
    rdfs:label "Intake prohibition"@en, "Innameverbod"@nl;
    vann:usageNote "Wordt bijvoorbeeld gebruikt naar aanleiding van evenementen."@nl;
    rdfs:comment "Ontzegging van bepaalde innames."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:SteunRetroreflecterendVerkeersbord a owl:Class;
    rdfs:label "Steun"@nl;
    rdfs:comment "Paal waaraan signalisatie bevestigd kan worden."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:DraagconstructieRetroreflecterendeVerkeersborden.
mobiliteit:Verkeersbordconcept a owl:Class;
    rdfs:label "Verkeersbordconcept"@nl;
    rdfs:comment "Concept van een bepaalde soort verkeersbord."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf skos:Concept.
mobiliteit:VerkeersbordconceptStatus a owl:Class;
    rdfs:label "Verkeersbordconceptstatus"@nl;
    rdfs:comment "Bevat de status van een verkeersbordconcept."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:VerkeerstekenWettelijkeStatus a owl:Class;
    rdfs:label "VerkeerstekenWettelijkeStatus"@nl;
    rdfs:comment "Bevat de wettelijke status van een verkeersteken."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Zone a owl:Class;
    rdfs:label "Zone"@nl;
    rdfs:comment "Ruimtelijk gebied."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Mobiliteitshindergevolg a owl:Class;
    rdfs:label "Mobiliteitshindergevolg"@nl;
    rdfs:comment "Verzameling doelgroepen die eenzelfde gevolg ondervinden door de mobiliteitshinder."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:RuimtelijkConflict a owl:Class;
    rdfs:label "Spatial Conflict"@en, "Ruimtelijk Conflict"@nl;
    rdfs:comment "Overlap of dicht bijeen liggen van zones in tijd en ruimte."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf generiek:Conflict.
mobiliteit:Opstelling a owl:Class;
    rdfs:label "Opstelling"@nl;
    rdfs:comment "Het geheel van verticale verkeerssignalisatie die bevestigd is aan één of meerdere draagconstructies op éénzelfde geolocatie."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Samenwerkingsantwoord a owl:Class;
    rdfs:label "Cooperation response"@en, "Samenwerkingsantwoord"@nl;
    rdfs:comment "Positief antwoord gegeven op een samenwerkingsaanvraag."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf generiek:Samenwerkingsantwoord.
mobiliteit:Synergie a owl:Class;
    rdfs:label "Synergy"@en, "Synergie"@nl;
    rdfs:comment "Groepering van werkopdrachten van nutsmaatschappijen."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:Project.
mobiliteit:Verankering a owl:Class;
    rdfs:label "Verankering"@nl;
    rdfs:comment "Bovengrondse en/of ondergrondse elementen die de opstelling ondersteunen."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Verkeersbord-Verkeersteken a owl:Class;
    rdfs:label "Verkeersbord-Verkeersteken"@nl;
    rdfs:comment "Verkeersteken dat gerealiseerd wordt met een verkeersbord."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:Verkeersteken.
mobiliteit:Bevestiging a owl:Class;
    rdfs:label "Bevestiging"@nl;
    rdfs:comment "Het montage-element dat een verkeersbord bevestigt aan een draagconstructie."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Grondwerk a owl:Class;
    rdfs:label "Grondwerk"@nl;
    vann:usageNote "Waarvoor een aanvraag tot werken noodzakelijk is of waarvoor een algemene vergunning tot uitvoering van werken geldt."@nl;
    rdfs:comment "Inname waarbij het openbaar domein of privaat domein met openbaar karakter wordt opengebroken voor wegenis-, riolerings- en/of nutwerken."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf mobiliteit:Inname.
mobiliteit:Mobiliteitshinder a owl:Class;
    rdfs:label "Mobility Hindrance"@en, "Mobiliteitshinder"@nl;
    rdfs:comment "Verstoring van de normale mobiliteit op het openbaar domein of privé domein met openbaar karakter."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Project a owl:Class;
    rdfs:label "Project"@nl;
    rdfs:comment "Groepering van innames, hinders, mobiliteitsmaatregelen en projecten."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf <http://xmlns.com/foaf/spec/#term_Project>.
mobiliteit:Advies a owl:Class;
    rdfs:label "Advies"@nl;
    rdfs:comment "Input van een partij die betrokken is bij het beslissingsproces."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf generiek:Advies.
mobiliteit:DraagconstructieVerkeersborden a owl:Class;
    rdfs:label "Draagconstructie verkeersborden"@nl;
    rdfs:comment "Stabiele voorziening waaraan een verkeersbord opgehangen kan worden."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Verkeersteken a owl:Class;
    rdfs:label "Verkeersteken"@nl;
    rdfs:comment "De voorstelling van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Mobiliteitsmaatregel a owl:Class;
    rdfs:label "Mobility Measure"@en, "Mobiliteitsmaatregel"@nl;
    rdfs:comment "Maatregel om de beweging en verplaatsing van de weggebruiker op het openbaar domein of privé domein met openbaar karakter te organiseren."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
mobiliteit:Samenwerkingsaanvraag a owl:Class;
    rdfs:label "Samenwerkingsaanvraag"@nl;
    rdfs:comment "Verzoek tot samenwerking in een project."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>;
    rdfs:subClassOf generiek:Samenwerkingsaanvraag.
mobiliteit:Inname a owl:Class;
    rdfs:label "Intake"@en, "Inname"@nl;
    rdfs:comment "Een tijdelijke activiteit die een bepaalde ruimte inneemt, met gevolgen voor het openbaar domein of privédomein met openbaar karakter."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/mobiliteit>.
<https://data.vlaanderen.be/ns/mobiliteit> a owl:Ontology;
    rdfs:label "Mobility"@en, "Mobiliteit"@nl.
