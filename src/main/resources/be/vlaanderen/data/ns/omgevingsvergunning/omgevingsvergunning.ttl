dbo:Case a rdfs:Class;
    rdfs:label "Zaak"@nl.
skos:Concept a rdfs:Class;
    rdfs:label "Vlarem Rubriek"@nl.
<https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit.juridischeKwalificatie> a owl:ObjectProperty;
    rdfs:label "juridische kwalificatie"@nl;
    rdfs:comment "De Juridische Kwalificatie van de Activiteit."@nl;
    rdfs:domain omgevingsvergunning:Activiteit;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range omgevingsvergunning:JuridischeCategorie.
<https://data.vlaanderen.be/ns/omgevingsvergunning#Activiteit.tijdsbestek> a owl:ObjectProperty;
    rdfs:label "tijdsbestek"@nl;
    rdfs:comment "Aanduiding van het tijdsbestek van de Activiteit."@nl;
    rdfs:domain omgevingsvergunning:Activiteit;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range time:Interval.
<https://data.vlaanderen.be/ns/omgevingsvergunning#Beroepsmogelijkheid.bevoegdeOverheid> a owl:ObjectProperty;
    rdfs:label "bevoegde overheid"@nl;
    rdfs:comment "De Publieke Organisatie bevoegd om zich over het Rechtsmiddel uit te spreken."@nl;
    rdfs:domain omgevingsvergunning:Beroepsmogelijkheid;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range eu:PublicOrganisation.
<https://data.vlaanderen.be/ns/omgevingsvergunning#BestuurlijkeRechtshandeling.verantwoordelijke> a owl:ObjectProperty;
    rdfs:label "verantwoordelijke"@nl;
    rdfs:domain omgevingsvergunning:BestuurlijkeRechtshandeling;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range eu:PublicOrganisation.
<https://data.vlaanderen.be/ns/omgevingsvergunning#NormatieveBepaling.tijdsbestek> a owl:ObjectProperty;
    rdfs:label "tijdsbestek"@nl;
    vann:usageNote "De toelating om een bepaalde Activiteit uit te voeren kan beperkt zijn in de tijd."@nl;
    rdfs:comment "Aanduiding van het tijdsbestek van de Normatieve Bepaling."@nl;
    rdfs:domain omgevingsvergunning:NormatieveBepaling;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range time:Interval.
omgevingsvergunning:Recht a owl:Class;
    rdfs:label "Recht"@nl;
    rdfs:comment "De toestemming om een bepaalde activiteit uit te voeren op een bepaalde locatie, waarvoor, op het moment van aanvraag of melding, een specifieke vergunning of melding vereist is volgens de geldende regelgeving op het gebied van ruimtelijke ordening en milieu."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:subClassOf omgevingsvergunning:NormatieveBepaling.
