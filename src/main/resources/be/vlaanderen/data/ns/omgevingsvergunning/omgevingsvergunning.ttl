    rdfs:range omgevingsvergunning:VaststellingVergundeToestand.
omgevingsvergunning:verwanteZaak a owl:ObjectProperty;
    rdfs:label "verwanteZaak"@nl;
    vann:usageNote "Verwantschappen kunnen verschillende doelstellingen hebben. De doelstelling mag een aangegeven worden in een gekwalificeerde relatie."@nl;
    rdfs:comment "Verwijzingen naar verwante Zaken."@nl;
    rdfs:domain dbo:Case;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range dbo:Case.
