    rdfs:comment "Termijn binnen dewelke de Procedure toegepast mag worden."@nl;
    rdfs:domain omgevingsvergunning:Procedure;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range time:Interval.
omgevingsvergunning:toestandDatum a owl:DatatypeProperty;
    rdfs:label "toestand datum"@nl;
