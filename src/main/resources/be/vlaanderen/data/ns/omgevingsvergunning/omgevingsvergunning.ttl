    rdfs:range omgevingsvergunning:Rechtscollege.
omgevingsvergunning:rechtsgrond a owl:ObjectProperty;
    rdfs:label "rechtsgrond"@nl;
    vann:usageNote "Bijvoorbeeld, de procedure voor de vereenvoudigde vergunningsprocedure is vastgesteld in de artikelen 37 en volgende van het Omgevingsdecreet, zoals van kracht op een bepaalde datum."@nl;
    rdfs:comment "Verwijzingen naar de Juridische Werken die de grondslag vormen van de Procedure."@nl;
    rdfs:domain omgevingsvergunning:Procedure;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/omgevingsvergunning>;
    rdfs:range omgevingsvergunning:JuridischWerk.
omgevingsvergunning:termijn a owl:ObjectProperty;
