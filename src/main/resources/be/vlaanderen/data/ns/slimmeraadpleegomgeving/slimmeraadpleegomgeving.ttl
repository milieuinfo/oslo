schemas:WebSite a rdfs:Class;
    rdfs:label "Website"@nl.
<https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#Activiteit.genereertAnnotatie> a owl:ObjectProperty;
    rdfs:label "genereert"@nl;
    rdfs:comment "De annotatie die werd aangemaakt als gevolg van de activiteit."@nl;
    rdfs:domain prov:Activity;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving>;
    rdfs:range oa:Annotation;
    rdfs:subPropertyOf prov:generates.
<https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#Annotatie.heeftLocatie> a owl:ObjectProperty;
    rdfs:label "heeft locatie"@nl;
    rdfs:comment "Locatie dat de annotatie gebruikt als inhoud voor een resource."@nl;
    rdfs:domain oa:Annotation;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving>;
    rdfs:range prov:Location;
    rdfs:subPropertyOf oa:hasBody.
<https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#Annotatie.heeftObject> a owl:ObjectProperty;
    rdfs:label "heeft object"@nl;
    rdfs:comment "Object dat de annotatie gebruikt als inhoud voor een resource."@nl;
    rdfs:domain oa:Annotation;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving>;
    rdfs:range prov:Entity;
    rdfs:subPropertyOf oa:hasBody.
<https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#Annotatie.heeftTekstueleInhoud> a owl:ObjectProperty;
    rdfs:label "heeft tekstuele inhoud"@nl;
    rdfs:comment "Tekst dat de annotatie gebruikt als inhoud voor een resource."@nl;
    rdfs:domain oa:Annotation;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving>;
    rdfs:range oa:TextualBody;
    rdfs:subPropertyOf oa:hasBody.
<https://data.vlaanderen.be/ns/slimmeraadpleegomgeving#Annotatie.heeftThema> a owl:ObjectProperty;
    rdfs:label "heeft thema"@nl;
    rdfs:comment "Thema-code dat de annotatie gebruikt als inhoud voor een resource."@nl;
    rdfs:domain oa:Annotation;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/slimmeraadpleegomgeving>;
