skos:Concept a rdfs:Class;
    rdfs:label "DosisFormaat"@nl.
observation-definitions.html:Observation a rdfs:Class;
    rdfs:label "Medische Observatie"@nl.
medication-definitions.html:Medication a rdfs:Class;
    rdfs:label "Medicatie"@nl.
practitioner-definitions.html:Practitioner a rdfs:Class;
    rdfs:label "Zorgverlener"@nl.
diagnosticreport-definitions:DiagnosticReport a rdfs:Class;
    rdfs:label "Medisch Verslag"@nl.
nutritionintake-definitions.html:NutritionIntake a rdfs:Class;
    rdfs:label "Voedingsinname"@nl.
<https://data.vlaanderen.be/ns/gezondheidstoestand#Apgarscore.score> a owl:ObjectProperty;
    rdfs:label "score"@nl;
    rdfs:comment "Een score van 0 tot 10 waarbij 5 aspecten van de pasgeborene worden beoordeeld (hartslag, ademhaling, spiertonus, reflexen en huidskleur)."@nl;
    rdfs:domain gezondheidstoestand:Apgarscore;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/gezondheidstoestand>;
    rdfs:range schemas:QuantitativeValue.
<https://data.vlaanderen.be/ns/gezondheidstoestand#Arts.steltOp> a owl:ObjectProperty;
    rdfs:label "stelt op"@nl;
    rdfs:comment "De Arts stelt een Medisch Verslag op."@nl;
    rdfs:domain gezondheidstoestand:Arts;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/gezondheidstoestand>;
    rdfs:range diagnosticreport-definitions:DiagnosticReport.
<https://data.vlaanderen.be/ns/gezondheidstoestand#AssistentieBevalling.heeftAssistentie> a owl:ObjectProperty;
    rdfs:label "heeft assistentie"@nl;
    rdfs:comment "Tijdens de Bevalling is er ondersteuning van externe zorgverleners."@nl;
    rdfs:domain gezondheidstoestand:AssistentieBevalling;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/gezondheidstoestand>;
    rdfs:range gezondheidstoestand:Bevallingstoestand.
<https://data.vlaanderen.be/ns/gezondheidstoestand#AssistentieBevalling.heeftBevallingstoestand> a owl:ObjectProperty;
    rdfs:label "heeft bevallingstoestand"@nl;
    rdfs:comment "De Bevallingstoestand die bij de specifieke AssistentieBevalling hoort."@nl;
    rdfs:domain gezondheidstoestand:Bevallingstoestand;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/gezondheidstoestand>;
    rdfs:range gezondheidstoestand:AssistentieBevalling.
gezondheidstoestand:Batch a owl:Class;
    rdfs:label "Batch"@nl;
    rdfs:comment "Specifieke informatie over verpakte producten. Het omvat gegevens zoals het batchnummer, de productiedatum, de vervaldatum en andere relevante details die betrekking hebben op een specifieke partij producten die tegelijkertijd geproduceerd en verpakt zijn."@nl;
