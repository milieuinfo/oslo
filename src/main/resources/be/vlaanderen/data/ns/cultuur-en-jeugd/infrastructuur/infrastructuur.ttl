<http://data.vlaanderen.be/ns/subsidie#SubsidiemaatregelConsumptie> a rdfs:Class;
    rdfs:label "Subsidie"@nl.
crm:E54_Dimension a rdfs:Class;
    rdfs:label "Dimensie"@nl.
skos:Concept a rdfs:Class;
    rdfs:label "Infrastructuurtype"@nl, "Openstellingtype"@nl, "Exclusiviteitstype"@nl, "Binnenruimtetype"@nl, "Buitenruimtetype"@nl, "Exploitatietype"@nl, "Kosttype"@nl, "Inkomsttype"@nl, "Eigenaarschapstype"@nl, "Faciliteittype"@nl, "Dimensietype"@nl, "Capaciteittype"@nl, "Verzekeringtype"@nl, "Energiebrontype"@nl, "Gebruiktype"@nl, "Beheertype"@nl, "Toegankelijkheidsonderdeel"@nl, "Overeenkomsttype"@nl, "Verbruiktype"@nl, "Licentietype"@nl, "PermanentieType"@nl.
schemas:FinancialProduct a rdfs:Class;
    rdfs:label "Verzekering"@nl.
schemas:MonetaryAmount a rdfs:Class, rdf:Property;
    rdfs:label "Geldbedrag"@nl, "bedrag"@nl.
schemas:Permit a rdfs:Class;
    rdfs:label "Vergunning"@nl.
<https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Beheer.beheerder> a owl:ObjectProperty;
    rdfs:label "beheerder"@nl;
    rdfs:comment "De Agent die instaat voor de zorg en verantwoordelijkheid van de Infrastructuur."@nl;
    rdfs:domain jc_infrastructuur:Beheer;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur>;
    rdfs:range dcterms:Agent.
<https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Bereikbaarheid.laasteOpenbaarVervoer> a owl:DatatypeProperty;
    rdfs:label "laatste openbaar vervoer"@nl;
    rdfs:comment "Het tijdstip waarop het openbaar vervoer ten laatste gebruikt kan worden op de bestemming."@nl;
    rdfs:domain jc_infrastructuur:Bereikbaarheid;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur>;
    rdfs:range xsd:dateTime.
<https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#Bereikbaarheid.mobiscore> a owl:DatatypeProperty;
    rdfs:label "mobiscore"@nl;
    rdfs:comment "Een index die aangeeft hoe goed een locatie scoort op vlak van mobiliteit."@nl;
    rdfs:domain jc_infrastructuur:Bereikbaarheid;
