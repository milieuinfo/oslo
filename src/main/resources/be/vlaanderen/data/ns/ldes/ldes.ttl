vlaanderen_ldes:AfgeleideCollectie a owl:Class;
    rdfs:label "AfgeleideCollectie"@nl;
    rdfs:comment "Een collectie die afgeleid is van een andere collectie."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf tree:Collection.
vlaanderen_ldes:DataServiceLDES a owl:Class;
    rdfs:label "DataServiceLDES"@nl;
    vann:usageNote "Het protocol is hier per default dat van de Linked Data Event Stream."@nl;
    rdfs:comment "Een verzameling van operaties die ofwel toegang bieden tot één of meer Linked Data Event Streams."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf dcat:DataService.
vlaanderen_ldes:OnveranderlijkObject a owl:Class;
    rdfs:label "OnveranderlijkObject"@nl;
    vann:usageNote "Een onveranderlijk object is het basiselement van een eventstream."@nl;
    rdfs:comment "Een onveranderlijkObject is het basiselement van een Linked Data Event Stream."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf vlaanderen_ldes:CollectieLid.
vlaanderen_ldes:VeranderlijkObject a owl:Class;
    rdfs:label "VeranderlijkObject"@nl;
    vann:usageNote "Een veranderlijk object wordt gebruikt als basiselement van een dataset. "@nl;
    rdfs:comment "Een veranderlijk object is een object wiens status nog kan veranderen nadat het werd gecreëerd."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf vlaanderen_ldes:CollectieLid.
vlaanderen_ldes:eventstreamView a owl:ObjectProperty;
    rdfs:label "eventstreamView"@nl;
    rdfs:comment "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
    rdfs:domain vlaanderen_ldes:RootNode;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range vlaanderen_ldes:EventstreamView.
vlaanderen_ldes:retentiebeleid a owl:ObjectProperty;
    rdfs:label "retentiebeleid"@nl;
    rdfs:comment "Een retentiebeleid is een beleid volgens welke elementen (i.e. data) verwijderd zullen worden."@nl;
    rdfs:domain vlaanderen_ldes:EventstreamView;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range ldes:RetentionPolicy.
vlaanderen_ldes:rootNode a owl:ObjectProperty;
    rdfs:label "rootNode"@nl;
    rdfs:comment "Een rootnode is een beginpagina, die zelf al leden kan bevatten, via wiens gelinkte paginas alle leden kunnen gevonden worden."@nl;
    rdfs:domain vlaanderen_ldes:EventstreamView;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range vlaanderen_ldes:RootNode.
vlaanderen_ldes:snapshotTot a owl:DatatypeProperty;
    rdfs:label "snapshotTot"@nl;
    rdfs:comment "Het tijdstip waarop de snapshot van de Linked Data Event Stream werd genomen. "@nl;
    rdfs:domain vlaanderen_ldes:Snapshot;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range xsd:dateTime.
vlaanderen_ldes:snapshotVan a owl:ObjectProperty;
    rdfs:label "snapshotVan"@nl;
    rdfs:comment "Verwijst naar de originele Linked Data Event Stream."@nl;
    rdfs:domain vlaanderen_ldes:Snapshot;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range vlaanderen_ldes:VersieEventStream.
vlaanderen_ldes:versieMaterialisatieTot a owl:DatatypeProperty;
    rdfs:label "versieMaterialisatieTot"@nl;
    vann:usageNote "Het attribuut versieMaterialisatieTot geeft weer tot op welk moment de versies werden geaggregeerd."@nl;
    rdfs:comment "Het tijdstip tot wanneer versies werden verwerkt."@nl;
    rdfs:domain vlaanderen_ldes:VersieMaterialisatie;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range xsd:dateTime.
vlaanderen_ldes:versiematerialisatieVan a owl:ObjectProperty;
    rdfs:label "versieMaterialisatieVan"@nl;
    rdfs:comment "Verwijst naar de originele Linked Data Event Stream."@nl;
    rdfs:domain vlaanderen_ldes:VersieMaterialisatie;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:range vlaanderen_ldes:Snapshot.
vlaanderen_ldes:VersieEventStream a owl:Class;
    rdfs:label "VersieEventStream"@nl;
    rdfs:comment "Een event stream waarvan de leden versies zijn."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf ldes:EventStream.
ldes:timestampPath a rdf:Property;
    rdfs:label "timestampPath"@nl.
ldes:versionOfPath a rdf:Property;
    rdfs:label "versionOfPath"@nl.
tree:member a rdf:Property;
    rdfs:label "lid"@nl.
tree:shape a rdf:Property;
    rdfs:label "shape"@nl.
vlaanderen_ldes:CollectieLid a owl:Class;
    rdfs:label "CollectieLid"@nl;
    vann:usageNote "Kan verder gespecialiseerd worden in functie van het soort collectie, bijvoorbeeld als de collectie een event stream is zijn de collectieleden onveranderlijke objecten."@nl;
    rdfs:comment "Een object dat deel uitmaakt van een collectie."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>.
vlaanderen_ldes:RootNode a owl:Class;
    rdfs:label "RootNode"@nl;
    vann:usageNote "Naar de rootnode wordt verwezen vanuit de eventstream bij voorkeur via een eventstream-view."@nl;
    rdfs:comment "Een RootNode is een beginpagina, die zelf al leden kan bevatten, via wiens gelinkte pagina's alle leden kunnen gevonden worden."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>.
vlaanderen_ldes:VersieMaterialisatie a owl:Class;
    rdfs:label "VersieMaterialisatie"@nl;
    vann:usageNote "Om deze reden (zie definitie) zijn de collectieleden veranderlijke - in plaats van onveranderlijke objecten."@nl;
    rdfs:comment "Een snapshot waarbij de versie-identificatoren zijn vervangen door object-identificatoren."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf tree:Collection, <https://www.w3.org/ns/dcat#Dataset>.
vlaanderen_ldes:EventstreamView a owl:Class;
    rdfs:label "EventstreamView"@nl;
    rdfs:comment "De event stream view connecteert de collectie met de rootnode zodanig dat alle leden van de collectie gevonden kunnen worden."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>.
vlaanderen_ldes:Snapshot a owl:Class;
    rdfs:label "Snapshot"@nl;
    rdfs:comment "Een event stream van versies waarbij enkel laatste versie behouden blijft t.o.v. een opgegeven datum."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/ldes>;
    rdfs:subClassOf ldes:EventStream, <https://www.w3.org/ns/dcat#Dataset>.
<https://data.vlaanderen.be/ns/ldes> a owl:Ontology;
    rdfs:label "ldes"@en, "ldes"@nl.
