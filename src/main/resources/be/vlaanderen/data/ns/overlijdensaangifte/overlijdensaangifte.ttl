overlijdensaangifte:GeassocieerdeOorzaak a owl:Class;
    rdfs:label "Geassocieerde Oorzaak"@nl;
    rdfs:comment "De geassocieerde oorzaak van een overlijden dat onrechtstreeks mee tot het Overlijden heeft geleid."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>.
overlijdensaangifte:Ongeval a owl:Class;
    rdfs:label "Ongeval"@nl;
    rdfs:comment "Een plotseling optredende, ongewilde en onvoorziene gebeurtenis, waarbij de inwerking van een externe oorzaak leidt tot fysiek letsel en waarbij geen sprake is van opzettelijk geweld of voedselvergiftiging."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>.
overlijdensaangifte:StoffelijkeRest a owl:Class;
    rdfs:label "Stoffelijke Rest"@nl;
    rdfs:comment "De stoffelijke overschot of het lichaam van de overleden Persoon na de StoffelijkeRestVerwerking."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>.
overlijdensaangifte:Uitvaartcontract a owl:Class;
    rdfs:label "Uitvaartcontract"@nl;
    rdfs:comment "Juridisch bindende overeenkomst tussen een Persoon en een uitvaartonderneming of verzekeringsmaatschappij met betrekking op de vooraf geplande regelingen en financiële aspecten van een Uitvaart."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>.
overlijdensaangifte:Overlijdenstoestand a owl:Class;
    rdfs:label "Overlijdenstoestand"@nl;
    rdfs:comment "De medische toestand bij het Overlijden van de Persoon"@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:subClassOf gezondheidstoestand:Gezondheidstoestand.
overlijdensaangifte:StoffelijkeRestverwerking a owl:Class;
    rdfs:label "Stoffelijke Restverwerking"@nl;
    rdfs:comment "De naverwerking van de stoffelijke resten van de overleden Persoon."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>.
overlijdensaangifte:Uitvaart a owl:Class;
    rdfs:label "Uitvaart"@nl;
    rdfs:comment "Een ceremonie of plechtigheid die wordt gehouden ter herdenking van een overleden Persoon."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:subClassOf fixme.com:Gebeurtenis.
overlijdensaangifte:Doodsoorzaak a owl:Class;
    rdfs:label "Doodsoorzaak"@nl;
    rdfs:comment "De oorzaak van een overlijden van een Persoon."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>.
overlijdensaangifte:Wilsbeschikking a owl:Class;
    rdfs:label "Wilsbeschikking"@nl;
    rdfs:comment "Een verzameling van bepalingen rond het Overlijden van een Persoon."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:subClassOf fixme.com:Output, fixme.com:Bewijs.
<https://data.vlaanderen.be/ns/overlijdensaangifte> a owl:Ontology;
    rdfs:label "overlijdensaangifte"@en, "overlijdensaangifte"@nl.
