crm:E52_Time-Span a rdfs:Class;
    rdfs:label "Tijdspanne"@nl.
skos:Concept a rdfs:Class;
    rdfs:label "StoffelijkeRestType"@nl, "RisicoType"@nl, "BezwaarType"@nl, "Observatiestatus"@nl, "LijkbezorgingType"@nl, "RitueelType"@nl, "ObservatieCategorie"@nl, "ICD"@nl, "AardOverlijden"@nl, "ProcedureZorgType"@nl, "MedischVerslagOverlijdenType"@nl, "Conceptietechniek"@nl, "DoodgeboorteType"@nl, "LiggingKindType"@nl, "Bevallingswijze"@nl, "AssistentieBevallingType"@nl, "OverlijdenAfhandelingenOutput"@nl, "OverlijdenAfhandelingDienst"@nl, "FoetaleBewakingType"@nl, "IndicatieKeizersnedeType"@nl, "ArtsType"@nl, "VoedingsinnameItem"@nl, "StatusMedischVerslag"@nl, "StatusZwangerschap"@nl, "MaatregelMedischVerslag"@nl, "LocatieOverlijdenType"@nl.
<https://data.vlaanderen.be/ns/overlijdensaangifte#Bewijs.datum> a owl:DatatypeProperty;
    rdfs:label "datum"@nl;
    rdfs:comment "Het moment in tijd wanneer het Bewijs werd geproduceerd."@nl;
    rdfs:domain eu:Evidence;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:range xsd:dateTime.
overlijdensaangifte:Crematie a owl:Class;
    rdfs:label "Crematie"@nl;
    rdfs:comment "Proces waarbij het lichaam van een overleden Persoon wordt verbrand tot as."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:subClassOf overlijdensaangifte:StoffelijkeRestverwerking.
overlijdensaangifte:Doodgeboorte a owl:Class;
    rdfs:label "Doodgeboorte"@nl;
    rdfs:comment "Het Overlijden van een baby in de baarmoeder of tijdens de Bevalling."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:subClassOf persoon:Overlijden.
<https://data.vlaanderen.be/ns/overlijdensaangifte#Doodsoorzaak.duur> a owl:ObjectProperty;
    rdfs:label "duur"@nl;
    rdfs:comment "De afbakening in tijd van de Doodsoorzaak."@nl;
    rdfs:domain overlijdensaangifte:Doodsoorzaak;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/overlijdensaangifte>;
    rdfs:range eu:PeriodOfTime.
<https://data.vlaanderen.be/ns/overlijdensaangifte#Doodsoorzaak.gelinktAan> a owl:ObjectProperty;
