prov:Association a rdfs:Class;
    rdfs:label "Agent (in rol)"@nl.
besluitvorming:agendaStatus a owl:ObjectProperty;
    rdfs:label "agenda status"@nl;
    vann:usageNote "Bijvoorbeeld Ontwerp, Tussentijds goedgekeurd, Definitief, etc."@nl;
    rdfs:comment "De toestand waarin de agenda zich bevindt voor een specifiek type."@nl;
    rdfs:domain besluitvorming:Agenda;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range skos:Concept.
besluitvorming:agendaType a owl:ObjectProperty;
    rdfs:label "agenda type"@nl;
    vann:usageNote "Bijvoorbeeld Spoedeisend, Aanvullend, etc."@nl;
    rdfs:comment "Soort agenda."@nl;
    rdfs:domain besluitvorming:Agenda;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range skos:Concept;
    rdfs:subPropertyOf dcterms:type.
besluitvorming:behandelt a owl:ObjectProperty;
    rdfs:label "behandelt"@nl;
    rdfs:comment "De Agenda die effectief wordt behandeld op de Vergaderactiviteit."@nl;
    rdfs:domain besluit:Vergaderactiviteit;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluitvorming:Agenda.
besluitvorming:beleidsveld a owl:ObjectProperty;
    rdfs:label "beleidsveld"@nl;
    rdfs:comment "De beleidsvelden waar deze besluitvormingsaangelegenheid onder valt."@nl;
    rdfs:domain besluitvorming:Besluitvormingsaangelegenheid;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range skos:Concept.
besluitvorming:beschrijft a owl:ObjectProperty;
    rdfs:label "beschrijft"@nl;
    rdfs:comment "De beslissing(en) die in dit verslag beschreven zijn."@nl;
    rdfs:domain besluitvorming:Verslag;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluitvorming:Beslissingsactiviteit;
    rdfs:subPropertyOf prov:wasGeneratedBy.
besluitvorming:geagendeerdStuk a owl:ObjectProperty;
    rdfs:label "geagendeerd stuk"@nl;
    rdfs:comment "Een gerelateerd stuk waarnaar wordt verwezen, geciteerd of anderszins aangegeven in het agendapunt"@nl;
    rdfs:domain besluit:Agendapunt;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range dossier:Stuk;
    rdfs:subPropertyOf dcterms:references.
besluitvorming:genereertAgendapunt a owl:ObjectProperty;
    rdfs:label "genereert agendapunt"@nl;
    rdfs:comment "Het agendapunt of de agendapunten die werden aangemaakt als gevolg van de agendering."@nl;
    rdfs:domain besluitvorming:Agendering;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluit:Agendapunt;
    rdfs:subPropertyOf prov:generated.
besluitvorming:genereertVerslag a owl:ObjectProperty;
    rdfs:label "genereert verslag"@nl;
    rdfs:comment "de schriftelijke neerslag van (een onderdeel) van deze behandeling van agendapunt."@nl;
    rdfs:domain besluit:BehandelingVanAgendapunt;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluitvorming:Verslag;
    rdfs:subPropertyOf prov:generated.
besluitvorming:geplandOpenbaar a owl:DatatypeProperty;
    rdfs:label "gepland openbaar"@nl;
    rdfs:comment "Geeft aan over de procedurestap al dan niet openbaar zal zijn."@nl;
    rdfs:domain dossier:Procedurestap;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range xsd:boolean.
besluitvorming:heeftAanleiding a owl:ObjectProperty;
    rdfs:label "heeft aanleiding"@nl;
    rdfs:comment "De motivatie voor het opstarten van de Besluitvormingsaangelegenheid."@nl;
    rdfs:domain besluitvorming:Besluitvormingsaangelegenheid;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluitvorming:Aanleiding.
besluitvorming:heeftBeslissing a owl:ObjectProperty;
    rdfs:label "heeft beslissing"@nl;
    rdfs:comment "De Beslissing die volgt uit de Behandeling van het Agendapunt."@nl;
    rdfs:domain besluit:BehandelingVanAgendapunt;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluitvorming:Beslissingsactiviteit.
besluitvorming:heeftBijlage a owl:ObjectProperty;
    rdfs:label "heeft bijlage"@nl;
    rdfs:comment "Een gerelateerd Stuk dat vereist is om het stuk zijn functie of samenhang te ondersteunen."@nl;
    rdfs:domain dossier:Stuk;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range dossier:Stuk;
    rdfs:subPropertyOf dcterms:requires.
besluitvorming:heeftNotulen a owl:ObjectProperty;
    rdfs:label "heeft notulen"@nl;
    rdfs:comment "De formele notulen van de vergadering."@nl;
    rdfs:domain besluit:Vergaderactiviteit;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range dossier:Stuk.
besluitvorming:heeftOorsprongIn a owl:ObjectProperty;
    rdfs:label "heeft oorsprong in"@nl;
    rdfs:comment "Het stuk waarop de aanleiding zich baseert."@nl;
    rdfs:domain besluitvorming:Aanleiding;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range dossier:Stuk;
    rdfs:subPropertyOf prov:wasInfluencedBy.
besluitvorming:isAgendaVoor a owl:ObjectProperty;
    rdfs:label "is agenda voor"@nl;
    rdfs:comment "De Vergaderactiviteit waarvoor de Agenda wordt voorbereid."@nl;
    rdfs:domain besluitvorming:Agenda;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluit:Vergaderactiviteit.
besluitvorming:isGehoudenDoor a owl:ObjectProperty;
    rdfs:label "is gehouden door"@nl;
    rdfs:comment "Duidt aan door welk orgaan de vergadering is gehouden."@nl;
    rdfs:domain besluit:Vergaderactiviteit;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range besluit:Bestuursorgaan;
    rdfs:subPropertyOf prov:wasStartedBy.
besluitvorming:korteTitel a owl:DatatypeProperty;
    rdfs:label "korte titel"@nl;
    rdfs:comment "Een verkorte vorm van de naam."@nl;
    rdfs:domain besluit:Agendapunt;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range xsd:string;
    rdfs:subPropertyOf dcterms:alternative.
besluitvorming:resultaat a owl:ObjectProperty;
    rdfs:label "resultaat"@nl;
    vann:usageNote "bijvoorbeeld goedkeuring, goedkeuring mits voorwaarden,afkeuring, verdaging,..."@nl;
    rdfs:comment "Eindoordeel van de beoordeling."@nl;
    rdfs:domain besluitvorming:Beslissingsactiviteit;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range skos:Concept.
besluitvorming:vertrouwelijkheidsniveau a owl:ObjectProperty;
    rdfs:label "vertrouwelijkheidsniveau"@nl;
    rdfs:comment "Indicatie van de gevoeligheid van het stuk en welke beperkingen gelden."@nl;
    rdfs:domain rdfs:Resource;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range skos:Concept;
    rdfs:subPropertyOf dcterms:accessRights.
besluitvorming:volgnummer a owl:DatatypeProperty;
    rdfs:label "volgnummer"@nl;
    rdfs:comment "Nummer van het stuk binnen een serie, kan bestaan uit cijfers of een combinatie van cijfers en alfanummerieke tekens."@nl;
    rdfs:domain dossier:Stuk;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:range xsd:string.
dcterms:description a rdf:Property;
    rdfs:label "beschrijving"@nl.
dcterms:isPartOf a rdf:Property;
    rdfs:label "is onderdeel van"@nl.
dcterms:replaces a rdf:Property;
    rdfs:label "vervangt"@nl.
dcterms:title a rdf:Property;
    rdfs:label "naam"@nl.
prov:hadRole a rdf:Property;
    rdfs:label "rol"@nl.
besluitvorming:Agendering a owl:Class;
    rdfs:label "Agendering"@nl;
    rdfs:comment "Het inplannen van de bespreking van een besluitvormingsaangelegenheid op een agenda."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:subClassOf prov:Activity.
dossier:openingsdatum a rdf:Property;
    rdfs:label "openingsdatum"@nl.
dossier:sluitingsdatum a rdf:Property;
    rdfs:label "sluitingsdatum"@nl.
dcterms:alternative a rdf:Property;
    rdfs:label "alternatieve naam"@nl.
besluitvorming:Aanleiding a owl:Class;
    rdfs:label "Aanleiding"@nl;
    vann:usageNote "Vooral aangeraden bij een formele aanleiding."@nl;
    rdfs:comment "Ontstaansgrond van een besluitvormingsaangelegenheid."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>.
besluitvorming:Besluitvormingsaangelegenheid a owl:Class;
    rdfs:label "Besluitvormingsaangelegenheid"@nl;
    rdfs:comment "Een samenhangende hoeveelheid activiteiten met een aanleiding en een beoogde beslissing."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:subClassOf dbo:Case.
besluitvorming:Verslag a owl:Class;
    rdfs:label "Verslag"@nl;
    rdfs:comment "De formele neerslag van (een onderdeel van) de behandeling van het agendapunt."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:subClassOf dossier:Stuk.
prov:generated a rdf:Property;
    rdfs:label "geeft aanleiding tot"@nl.
besluitvorming:Beslissingsactiviteit a owl:Class;
    rdfs:label "Beslissingsactiviteit"@nl;
    rdfs:comment "Beoordeling door de bevoegde(n) van het voorgelegde agendapunt of stuk(ken)."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:subClassOf prov:Activity.
besluitvorming:Agenda a owl:Class;
    rdfs:label "Agenda"@nl;
    vann:usageNote "De agenda behoort niet tot het dossier van de besluitvormingsaangelegenheid"@nl;
    rdfs:comment "Een geordende lijst van agendapunten voor een Vergaderactiviteit."@nl;
    rdfs:isDefinedBy <https://data.vlaanderen.be/ns/besluitvorming>;
    rdfs:subClassOf dossier:Stuk.
<https://data.vlaanderen.be/ns/besluitvorming> a owl:Ontology;
    rdfs:label "besluitvorming"@en, "besluitvorming"@nl.
