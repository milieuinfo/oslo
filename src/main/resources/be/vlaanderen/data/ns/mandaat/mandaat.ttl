besluit:Bestuursorgaan a rdfs:Class.
mandaat:Fractie a owl:Class;
    rdfs:label "Parliamentary Group"@en, "Fractie"@nl;
    rdfs:comment "A parliamentary group is a part of a directly elected representative body whose members wish to work together on a substantive and logistical level. The formal framework defines who can form a parliamentary group, usually it consists of representatives representing the same political party or flow."@en, "Een fractie is een deel van een rechtstreeks verkozen volksvertegenwoordigend orgaan waarvan de leden op inhoudelijk en logistiek vlak willen samenwerken. Het formeel kader bepaalt wie samen een fractie kan vormen, doorgaans bestaat ze uit volksvertegenwoordigers die tot dezelfde politieke partij of stroming behoren."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subClassOf org:Organization.
mandaat:aantalHouders a rdf:Property;
    rdfs:label "number of holders"@en, "aantal houders"@nl;
    rdfs:comment "Maximum number of agents that can hold this post at the same time."@en, "Maximale aantal agents die tegelijk deze positie kunnen invullen."@nl;
    rdfs:domain mandaat:Mandaat;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subPropertyOf organisatie:aantalHouders.
mandaat:aantalNaamstemmen a owl:DatatypeProperty;
    rdfs:label "number of preference votes"@en, "aantal naamstemmen"@nl;
    rdfs:comment "The number of preferential votes for the candidate in the election, without taking list votes into account."@en, "Het aantal stemmen dat is uitgebracht op de kandidaat bij de verkiezing, zonder de lijststemmen in rekening te brengen."@nl;
    rdfs:domain mandaat:Verkiezingsresultaat;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range xsd:integer.
mandaat:behoortTot a owl:ObjectProperty;
    rdfs:label "belongs to"@en, "behoort tot"@nl;
    rdfs:comment "The election of which the candidate list is a part of."@en, "De verkiezing waar de lijst onderdeel van is."@nl;
    rdfs:domain mandaat:Kandidatenlijst;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:RechtstreekseVerkiezing.
mandaat:bekrachtigtAanstellingVan a owl:ObjectProperty;
    rdfs:label "ratifies appointment of"@en, "bekrachtigt aanstelling van"@nl;
    rdfs:comment "The mandatary whose appointment is ratified."@en, "De mandataris wiens aanstelling is bekrachtigd."@nl;
    rdfs:domain mandaat:RechtsgrondAanstelling;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:Mandataris.
mandaat:bekrachtigtOntslagVan a owl:ObjectProperty;
    rdfs:label "ratifies dismissal of"@en, "bekrachtigt ontslag van"@nl;
    rdfs:comment "The mandatary whose dismissal is ratified."@en, "De mandataris wiens ontslag is bekrachtigd."@nl;
    rdfs:domain mandaat:RechtsgrondBeeindiging;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:Mandataris.
mandaat:beleidsdomein a owl:ObjectProperty;
    rdfs:label "policy domain"@en, "beleidsdomein"@nl;
    rdfs:comment "The theme or policy domain assigned to a mandatary."@en, "Het thema of beleidsdomein dat toegewezen is aan een mandataris."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range skos:Concept.
mandaat:datum a owl:DatatypeProperty;
    rdfs:label "date"@en, "datum"@nl;
    rdfs:comment "Date on which the election took place."@en, "Datum waarop de verkiezing plaatsvond."@nl;
    rdfs:domain mandaat:RechtstreekseVerkiezing;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range xsd:date;
    rdfs:subPropertyOf dcterms:date.
mandaat:einde a owl:DatatypeProperty;
    rdfs:label "end"@en, "einde"@nl;
    rdfs:comment "Time when the appointment of the mandate stops."@en, "Tijdstip vanaf wanneer de mandataris het mandaat niet langer opneemt."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range xsd:dateTime.
mandaat:gevolg a owl:ObjectProperty;
    rdfs:label "consequence"@en, "gevolg"@nl;
    vann:usageNote "Examples: not elected, effectively, successor."@en, "Voorbeelden: niet verkozen, effectief, opvolger."@nl;
    rdfs:comment "Personal consequence of the result for the candidate that determines if the candidate may or may not participate in the governing body."@en, "Persoonlijk gevolg van de uitslag voor de kandidaat dat vastlegt of de kandidaat al dan niet kan deelnemen aan het bestuursorgaan."@nl;
    rdfs:domain mandaat:Verkiezingsresultaat;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range skos:Concept.
mandaat:heeftKandidaat a owl:ObjectProperty;
    rdfs:label "has candidate"@en, "heeft kandidaat"@nl;
    rdfs:comment "A person that is part of the list."@en, "Een persoon die deel uitmaakt van de lijst."@nl;
    rdfs:domain mandaat:Kandidatenlijst;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range person:Person.
mandaat:isAangesteldAls a owl:ObjectProperty;
    rdfs:label "is appointed as"@en, "is aangesteld als"@nl;
    rdfs:comment "A role as mandatary belonging to the person."@en, "Een mandatarisrol die eigen is aan de persoon."@nl;
    rdfs:domain person:Person;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:Mandataris;
    rdfs:subPropertyOf prov:generalizationOf.
mandaat:isAangesteldDoor a owl:ObjectProperty;
    rdfs:label "appointed by"@en, "is aangesteld door"@nl;
    rdfs:comment "The legal resource that ratifies the appointment of the mandatary."@en, "De rechtsgrond die de aanstelling van de mandataris vastlegt."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:RechtsgrondAanstelling.
mandaat:isBestuurlijkeAliasVan a owl:ObjectProperty;
    rdfs:label "is governing alias of"@en, "is bestuurlijke alias van"@nl;
    rdfs:comment "The person assuming the role as mandatary."@en, "De persoon die de mandatarisrol vervult."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range person:Person;
    rdfs:subPropertyOf prov:specializationOf.
mandaat:isOntslagenDoor a owl:ObjectProperty;
    rdfs:label "is dismissed by"@en, "is ontslagen door"@nl;
    rdfs:comment "The legal resource that ratifies the dismissal of the mandatary."@en, "De rechtsgrond die het ontslag van de mandataris vastlegt."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:RechtsgrondBeeindiging.
mandaat:isResultaatVan a owl:ObjectProperty;
    rdfs:label "is result of"@en, "is resultaat van"@nl;
    rdfs:comment "The person to whom the result belongs."@en, "De persoon horende bij het resultaat."@nl;
    rdfs:domain mandaat:Verkiezingsresultaat;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range person:Person.
mandaat:isResultaatVoor a owl:ObjectProperty;
    rdfs:label "is result for"@en, "is resultaat voor"@nl;
    rdfs:comment "The list to which the result relates."@en, "De lijst waarop het resultaat betrekking heeft."@nl;
    rdfs:domain mandaat:Verkiezingsresultaat;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:Kandidatenlijst.
mandaat:isTijdelijkVervangenDoor a owl:ObjectProperty;
    rdfs:label "temporarily replaced by"@en, "is tijdelijk vervangen door"@nl;
    vann:usageNote "The period of replacement corresponds to the start and end date of the appointment of the replacing mandatary."@en, "De periode van vervanging komt overeen met de start-/einddatum van de opname van het mandaat van de vervanger."@nl;
    rdfs:comment "A mandatary that has temporarily taken over the execution of the mandate."@en, "Duidt een mandataris aan die tijdelijk de uitvoering van het mandaat heeft overgenomen."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range mandaat:Mandataris.
mandaat:lijstnummer a owl:DatatypeProperty;
    rdfs:label "list number"@en, "lijstnummer"@nl;
    rdfs:comment "The index number of the list."@en, "Het volgnummer van de lijst."@nl;
    rdfs:domain mandaat:Kandidatenlijst;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range xsd:integer.
mandaat:lijsttype a owl:ObjectProperty;
    rdfs:label "list type"@en, "lijsttype"@nl;
    vann:usageNote "For example: municipal election, parliamentary election."@en, "Bijvoorbeeld: gemeenteraadsverkiezing, effectieven Vlaams Parlement."@nl;
    rdfs:comment "The type of the list."@en, "Het type van de lijst."@nl;
    rdfs:domain mandaat:Kandidatenlijst;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range skos:Concept.
mandaat:plaatsRangorde a owl:DatatypeProperty;
    rdfs:label "ranking"@en, "plaats rangorde"@nl;
    rdfs:comment "The position in the list of effective elected or in the list of successors, based on the number of preferential votes of the candidate and the number of transferred list votes."@en, "De positie in de volgorde op de lijst van effectief verkozenen of op de lijst van opvolgers, op basis van het aantal naamstemmen van de kandidaat plus het aantal overgedragen lijststemmen."@nl;
    rdfs:domain mandaat:Verkiezingsresultaat;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range xsd:integer.
mandaat:rangorde a owl:DatatypeProperty;
    rdfs:label "ranking"@en, "rangorde"@nl;
    rdfs:comment "Indicates the location of the mandatary in the formally determined order of mandataries within the governing body in which the mandatary is located."@en, "Duidt de plaats van de mandataris aan in de formeel vastgelegde volgorde van de mandatarissen binnen het bestuursorgaan waar de mandataris in zetelt."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range rdf:langString.
mandaat:redenVanBeeindiging a owl:ObjectProperty;
    rdfs:label "reden van beëindiging"@nl;
    rdfs:comment "De reden waarom deze rechtsgrond werd beëindigd."@nl;
    rdfs:domain mandaat:RechtsgrondBeeindiging;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range skos:Concept.
mandaat:start a owl:DatatypeProperty;
    rdfs:label "start"@en, "start"@nl;
    rdfs:comment "Time when the appointment of the mandate starts."@en, "Tijdstip vanaf wanneer de mandataris het mandaat opneemt."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range xsd:dateTime;
    rdfs:subPropertyOf mandaat:specialisatieStart.
mandaat:status a owl:ObjectProperty;
    rdfs:label "status"@en, "status"@nl;
    vann:usageNote "Examples: effective, terminated, acting."@en, "Voorbeelden: effectief, verhinderd, beëindigd, waarnemend."@nl;
    rdfs:comment "The status of the mandatary."@en, "De gesteldheid van de mandataris."@nl;
    rdfs:domain mandaat:Mandataris;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range skos:Concept.
mandaat:steltSamen a owl:ObjectProperty;
    rdfs:label "forms"@en, "stelt samen"@nl;
    rdfs:comment "The governing body whose composition is determined by the election."@en, "Het orgaan waarvan de samenstelling wordt bepaald door de verkiezing."@nl;
    rdfs:domain mandaat:RechtstreekseVerkiezing;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:range besluit:Bestuursorgaan.
dcterms:valid a rdf:Property;
    rdfs:label "geldig"@nl.
skos:prefLabel a rdf:Property;
    rdfs:label "voorkeursnaam"@nl.
org:hasPost a rdf:Property;
    rdfs:label "heeft positie"@nl.
org:holds a rdf:Property;
    rdfs:label "bekleedt"@nl.
org:role a rdf:Property;
    rdfs:label "rol"@nl.
rov:legalName a rdf:Property;
    rdfs:label "wettelijke naam"@nl.
mandaat:Mandaat a owl:Class;
    rdfs:label "mandate"@en, "Mandaat"@nl;
    rdfs:comment "The power to form or join a governing body for a certain period of time. A mandate may represent one or more seats."@en, "De bevoegdheid om gedurende een bepaalde periode een bestuursorgaan te vormen of er deel van uit te maken. Een mandaat kan één of meerdere zetels voorstellen."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subClassOf org:Post.
mandaat:RechtsgrondAanstelling a owl:Class;
    rdfs:label "Legal Resource Appointment"@en, "Rechtsgrond Aanstelling"@nl;
    rdfs:comment "The regulations, legal act and/or policy choice which (temporarily) appoints one or more mandates to a person starting from a specific date."@en, "De regelgeving, rechtshandeling en/of beleidskeuze waardoor de invulling van een of meerdere mandaten door een persoon vanaf een bepaalde datum (tijdelijk) start."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subClassOf eli:LegalResource, cpsv:FormalFramework.
mandaat:RechtsgrondBeeindiging a owl:Class;
    rdfs:label "Legal Resource Dismissal"@en, "Rechtsgrond Beëindiging"@nl;
    rdfs:comment "The regulations, legal act and/or policy choice which (temporarily) dismisses one or more mandates of a person starting from a specific date."@en, "De regelgeving, rechtshandeling en/of beleidskeuze waardoor de invulling van één of meerdere mandaten door een persoon vanaf een bepaalde datum (tijdelijk) beëindigd wordt."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subClassOf eli:LegalResource, cpsv:FormalFramework.
mandaat:RechtstreekseVerkiezing a owl:Class;
    rdfs:label "Direct Election"@en, "Rechtstreekse Verkiezing"@nl;
    rdfs:comment "The execution of a formal procedure whereby voting citizens determines which person can be assigned a mandate."@en, "De uitvoering van een formele procedure waarbij stemgerechtigde burgers bepalen aan welke persoon een mandaat kan worden toegekend."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subClassOf prov:Activity.
mandaat:Kandidatenlijst a owl:Class;
    rdfs:label "Candidate List"@en, "Kandidatenlijst"@nl;
    rdfs:comment "List with candidates for an election."@en, "Lijst met kandidaten voor een verkiezing."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>.
mandaat:Verkiezingsresultaat a owl:Class;
    rdfs:label "Election Result"@en, "Verkiezingsresultaat"@nl;
    rdfs:comment "Individual election result of a candidate."@en, "Individuele verkiezingsuitslag van een kandidaat."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>.
mandaat:Mandataris a owl:Class;
    rdfs:label "Mandatary"@en, "Mandataris"@nl;
    rdfs:comment "A person in his role as holder of a mandate."@en, "Een persoon in zijn rol als houder van een mandaat."@nl;
    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/mandaat>;
    rdfs:subClassOf dcterms:Agent.
<http://data.vlaanderen.be/ns/mandaat> a owl:Ontology;
    rdfs:label "Mandate"@en, "Mandaat"@nl.
